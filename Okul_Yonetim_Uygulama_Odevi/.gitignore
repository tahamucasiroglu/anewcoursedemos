# VS Code extension build output (extensions/vscode)
extensions/vscode/node_modules/
extensions/vscode/out/
extensions/vscode/*.vsix

# Uygulama logları (ADR-0003) — repoya girmez
logs/

# Geliştirme e-postaları (spec 0006) — yenileme bağlantısı içerir, repoya girmez
mail-outbox/

# Derleme / paket çıktıları
bin/
obj/
node_modules/
dist/
.expo/
web-build/
*.tsbuildinfo
coverage/

# Yerel yapay zekâ ortamı (MVP: ses→metin ve metin modeli) — kurulum ve modeller repoya girmez
tools/ai/.venv/
tools/ai/models/
tools/ai/__pycache__/

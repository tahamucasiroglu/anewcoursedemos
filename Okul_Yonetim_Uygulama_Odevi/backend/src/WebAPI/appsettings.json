  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Okul Yönetim",
    "WebBaseUrl": "",
    "PickupDirectory": "",
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "*"
}

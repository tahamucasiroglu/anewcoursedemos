{
  "ConnectionStrings": {
    "OkulDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "FileLogging": {
    "Folder": "logs",
    "RetainedDays": 30,
    "FileSizeLimitBytes": 104857600,
    "Console": false

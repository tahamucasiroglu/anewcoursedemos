  "components": {
    "schemas": {
      "AddMemberRequest": {
        "required": [
          "fullName",
          "email",
          "phone",
          "roles"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleInput"
            }
          }
        },
        "description": "Kişi ekleme isteği: ad-soyad, e-posta, isteğe bağlı telefon ve roller (rol + şubeler)."
      },
      "AddMemberResult": {
        "required": [
          "userId",
          "existingAccount",
          "temporaryPassword"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "existingAccount": {
            "type": "boolean"
          },
          "temporaryPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Ekleme sonucu: kişi kimliği; e-posta sistemde zaten kayıtlıysa `ExistingAccount` (şifre üretilmez, değişmez);\ndeğilse bir kez gösterilecek geçici şifre. Bu yanıt dışında geçici şifre hiçbir yerde yer almaz."
      },
      "AuthTokensResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "requiresTenantSelection",
          "tenants"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "requiresTenantSelection": {
            "type": "boolean"
          },
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantSummary"
            }
          }
        },
        "description": "Giriş / yenileme / okul seçimi yanıtı: erişim anahtarı ve bitişi; yenileme anahtarı yalnızca mobil (gövde) isteğinde\ndolu, web'de boş (çerezde); okul seçimi gerekiyor mu; kişinin okulları."
      },
      "BranchAdminView": {
        "required": [
          "id",
          "name",
          "address",
          "phone",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "description": "Yönetim ekranındaki şube: ad, adres, telefon ve durum (pasif şubeler de listelenir)."
      },
      "BranchRequest": {
        "required": [
          "name",
          "address",
          "phone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        },

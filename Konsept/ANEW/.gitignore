# OS / editors
.DS_Store
Thumbs.db
.idea/
*.swp

# Secrets — never commit these
.env
.env.*
!.env.example

# Logs
*.log

# Claude Code personal settings (shared settings.json IS committed after init)
.claude/settings.local.json

# Proje kaynak klasörü (ilk_promt.txt: görseller, ikon, videolar). Repo kökündeki .gitignore
# "Source/" satırı Windows'ta (core.ignorecase) bu klasörü de dışlıyordu; burada geri alınıyor.
!source/

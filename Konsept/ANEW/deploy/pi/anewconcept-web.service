# ANEW Konsept Web — Pi (spec 0001 AC-10). Port 8000 (D2). Web veritabanına bağlanmaz; API'ye localhost'tan gider.
# Servis anahtarı (Web → Api log iletimi, plan 0008) /etc/anewconcept/web.env'de (repoda yok).
[Unit]
Description=ANEW Konsept Web
After=network-online.target anewconcept-api.service
Wants=network-online.target

[Service]
Type=simple
User=anewconcept
Group=anewconcept
WorkingDirectory=/opt/anewconcept/web
ExecStart=/opt/anewconcept/web/Konsept.Web
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:8000
Environment=Api__BaseUrl=http://127.0.0.1:8001/
Environment=Logging__Directory=/opt/anewconcept/logs/web
# Konsol kapalı: journald (Pi'de kalıcı, 3 ay) /opt/anewconcept dışında log tutmasın (spec 0008 AC-5, review M-4).
Environment=Logging__Console=false
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
EnvironmentFile=/etc/anewconcept/web.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

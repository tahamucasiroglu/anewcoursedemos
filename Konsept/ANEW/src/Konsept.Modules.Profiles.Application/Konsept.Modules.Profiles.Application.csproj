<Project Sdk="Microsoft.NET.Sdk">
  <!-- Profiles use-case'leri: listele (seçili + şablonlar), oluştur, düzenle, sil, seç. Infrastructure'a referans vermez (Y-3). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Konsept.Modules.Profiles.Domain\Konsept.Modules.Profiles.Domain.csproj" />
    <!-- Seçilebilir metin modelleri (spec 0005, Y-1: yalnızca AiGateway'in Contracts'ı). -->
    <ProjectReference Include="..\Konsept.Modules.AiGateway.Contracts\Konsept.Modules.AiGateway.Contracts.csproj" />
    <!-- Kendi Contracts'ı (0014: üretim bağlamı) ve Concepts'in Contracts'ı (konsepti olan profil silinemez, 0014 Req 26). -->
    <ProjectReference Include="..\Konsept.Modules.Profiles.Contracts\Konsept.Modules.Profiles.Contracts.csproj" />
    <ProjectReference Include="..\Konsept.Modules.Concepts.Contracts\Konsept.Modules.Concepts.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kullanıcıya dönen metinler yalnızca resx'te (Türkçe). Derlemede tipli ProfilesText sınıfı üretilir. -->
    <EmbeddedResource Update="Resources\ProfilesText.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)ProfilesText.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Konsept.Modules.Profiles.Application.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ProfilesText</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

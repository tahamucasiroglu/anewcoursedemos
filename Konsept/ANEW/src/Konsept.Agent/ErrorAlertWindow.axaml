<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Konsept.Agent.ErrorAlertWindow"
        Width="520" SizeToContent="Height" MaxHeight="640"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource KonseptWindowBackground}"
        Foreground="{DynamicResource KonseptWindowForeground}"
        Icon="/Assets/app-icon.png">
  <!-- Ajan hata uyarısı (spec 0022 Req 4): maskelenmiş özet, "Bildir" / "Kapat" / "Hata raporunu dosyaya kaydet", "Ayrıntıları göster". -->
  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource KonseptAccentBrush}" />
    <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
    <SelectableTextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" />
    <Button x:Name="DetailsButton" />
    <ScrollViewer x:Name="DetailsPanel" IsVisible="False" MaxHeight="260">
      <SelectableTextBlock x:Name="DetailsText" TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace" FontSize="12" />
    </ScrollViewer>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ReportButton" />
      <Button x:Name="SaveButton" />
      <Button x:Name="CloseButton" />
    </StackPanel>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
  </StackPanel>
</Window>

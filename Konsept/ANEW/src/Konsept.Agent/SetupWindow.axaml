<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Konsept.Agent.SetupWindow"
        Width="680" Height="720" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource KonseptWindowBackground}"
        Foreground="{DynamicResource KonseptWindowForeground}"
        Icon="/Assets/app-icon.png">
  <!--
    İlk kurulum ekranı (spec 0009 Req 2–5, 9–10, 13–14, 16, 18, 20, 23): kurulum yeri, video klasörü, bileşen listesi (ad, amaç,
    lisans, boyut, durum; Hata satırında Tekrar dene / Hatayı bildir, Onarılmalı satırında Onar), lisans onayı, ön kontrol, ilerleme
    ve akan Türkçe satırlar. Renkler yalnızca App.axaml'daki palet anahtarlarından; metinler resx'ten (kod tarafında).
  -->
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource KonseptAccentBrush}" />
      <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
      <TextBlock x:Name="InstallRootText" TextWrapping="Wrap" Foreground="{DynamicResource KonseptMutedBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="VideoLabel" VerticalAlignment="Center" />
        <TextBox x:Name="VideoFolderBox" Width="380" />
        <Button x:Name="VideoChangeButton" />
      </StackPanel>
      <TextBlock x:Name="VideoErrorText" TextWrapping="Wrap" Foreground="{DynamicResource KonseptErrorBrush}" IsVisible="False" />
      <TextBlock x:Name="ComponentsLabel" FontWeight="SemiBold" Margin="0,6,0,0" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
      <TextBlock x:Name="CurrentText" FontWeight="SemiBold" />
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="10" />
      <TextBlock x:Name="LicenseText" TextWrapping="Wrap" Foreground="{DynamicResource KonseptMutedBrush}" />
      <CheckBox x:Name="AcceptBox" />
      <TextBlock x:Name="SpaceText" />
      <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="{DynamicResource KonseptErrorBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="StartButton" Classes="accent" />
      </StackPanel>
      <TextBlock x:Name="DoneText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource KonseptAccentBrush}" />
      <Border x:Name="ConfirmPanel" IsVisible="False" Padding="12" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource KonseptSurfaceBrush}" BorderBrush="{DynamicResource KonseptBorderBrush}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="YesButton" />
            <Button x:Name="NoButton" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid RowDefinitions="*,Auto,120">
      <ScrollViewer Grid.Row="0">
        <StackPanel x:Name="ComponentList" Spacing="6" />
      </ScrollViewer>
      <TextBlock Grid.Row="1" x:Name="LogLabel" FontWeight="SemiBold" Margin="0,8,0,4" />
      <ListBox Grid.Row="2" x:Name="LogList" Background="{DynamicResource KonseptSurfaceBrush}" />
    </Grid>
  </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- AiGateway use-case'leri: katalog listesi, API key kaydet/değiştir/sil/listele. Infrastructure'a referans vermez (Y-3). -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Konsept.Modules.AiGateway.Domain\Konsept.Modules.AiGateway.Domain.csproj" />
    <ProjectReference Include="..\Konsept.Modules.AiGateway.Contracts\Konsept.Modules.AiGateway.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kullanıcıya dönen metinler yalnızca resx'te (Türkçe). Derlemede tipli AiGatewayText sınıfı üretilir. -->
    <EmbeddedResource Update="Resources\AiGatewayText.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)AiGatewayText.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Konsept.Modules.AiGateway.Application.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>AiGatewayText</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

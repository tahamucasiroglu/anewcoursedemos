@{
    ViewData["RequiresProfile"] = true;
    ViewData["Title"] = UiText.NavConcepts;
    // Rol kodları ve ince ayar kodları Api'deki ConceptSettingsRules ile aynıdır; görünen metinler resx'te (spec 0005).
    var roles = new (string Code, string Short, string ModelLabel, string EffortLabel)[]
    {
        ("concept", UiText.ConceptRoleConcept, UiText.ConceptModelConcept, UiText.ConceptEffortConcept),
        ("dedupe", UiText.ConceptRoleDedupe, UiText.ConceptModelDedupe, UiText.ConceptEffortDedupe),
        ("topic", UiText.ConceptRoleTopic, UiText.ConceptModelTopic, UiText.ConceptEffortTopic),
    };
    var groups = new (string Name, string Label, (string Code, string Text)[] Options)[]
    {
        ("tone", UiText.FineTuneTone, new[]
        {
            ("mysterious", UiText.ToneMysterious), ("educational", UiText.ToneEducational), ("dramatic", UiText.ToneDramatic),
            ("calm", UiText.ToneCalm), ("documentary", UiText.ToneDocumentary), ("humorous", UiText.ToneHumorous),
            ("inspiring", UiText.ToneInspiring), ("questioning", UiText.ToneQuestioning),
        }),
        ("audience", UiText.FineTuneAudience, new[]
        {
            ("beginner", UiText.AudienceBeginner), ("curious", UiText.AudienceCurious), ("family", UiText.AudienceFamily),
            ("expert", UiText.AudienceExpert),
        }),
        ("narration", UiText.FineTuneNarration, new[]
        {
            ("single_story", UiText.NarrationSingleStory), ("list", UiText.NarrationList),
            ("myth_or_fact", UiText.NarrationMythOrFact), ("what_if", UiText.NarrationWhatIf),
        }),
    };
}
@* Konseptler (spec 0005): üst barın altında şerit (solda model bilgisi, ortada ince ayar, sağda kelime denetimi) ve altında dört
   alan. Ayarlar seçili profile aittir; concepts.js /konsept-ayarlari/{profil} uçlarını kullanır ($.ajax, K-6). Profil yokken şerit ve
   alanlar gizlidir (profiles.js), "Önce bir profil oluşturun" ve + yönlendirmesi görünür. *@
<h1 class="page__title visually-hidden">@UiText.NavConcepts</h1>
<div class="concepts-no-profile" data-requires-no-profile hidden>
    <p>@UiText.ConceptsNoProfileHint</p>
    <button type="button" class="button button--primary" id="concepts-add-profile">@UiText.ConceptsNoProfileAction</button>
</div>

<section class="concept-strip" id="concept-strip" aria-label="@UiText.ConceptStripLabel" data-requires-profile data-state="loading"
         data-url="/konsept-ayarlari" data-text-loading="@UiText.ConceptSettingsLoading"
         data-text-load-failed="@UiText.ConceptSettingsLoadFailed" data-text-saving="@UiText.ConceptSettingsSaving"
         data-text-saved="@UiText.ConceptSettingsSaved" data-text-save-failed="@UiText.ConceptSettingsSaveFailed"
         data-text-not-selected="@UiText.ConceptNotSelected" data-text-unspecified="@UiText.ConceptUnspecified">
    <button type="button" class="concept-strip__models" id="concept-models-open" aria-haspopup="dialog" aria-controls="concept-models-modal"
            title="@UiText.ConceptModelsOpen" disabled>
        @foreach (var role in roles)
        {
            <span class="concept-strip__role" data-role="@role.Code">@role.Short: <span class="concept-strip__value" data-role-value>@UiText.ConceptNotSelected</span></span>
        }
    </button>
    <button type="button" class="concept-strip__finetune" id="concept-finetune-toggle" aria-expanded="false" aria-controls="concept-finetune"
            title="@UiText.ConceptFineTuneOpen" disabled>
        <span class="concept-strip__label">@UiText.ConceptFineTune:</span>
        @foreach (var group in groups)
        {
            <span class="concept-strip__group" data-group="@group.Name">@group.Label: <span class="concept-strip__value" data-group-value>@UiText.ConceptUnspecified</span></span>
        }
    </button>
    <label class="concept-strip__wordcheck">
        <input type="checkbox" id="concept-wordcheck" disabled />
        @UiText.ConceptWordCheck
    </label>
    <p class="concept-strip__status" id="concept-settings-status" role="status" aria-live="polite">@UiText.ConceptSettingsLoading</p>

    <div class="concept-finetune" id="concept-finetune" hidden>
        @foreach (var group in groups)
        {
            <fieldset class="concept-finetune__group">
                <legend>@group.Label</legend>
                <label class="concept-finetune__option"><input type="radio" name="@group.Name" value="" checked /> @UiText.ConceptUnspecified</label>
                @foreach (var option in group.Options)
                {
                    <label class="concept-finetune__option"><input type="radio" name="@group.Name" value="@option.Code" /> @option.Text</label>
                }
            </fieldset>
        }
    </div>
</section>

@* Dört alan (spec 0014): sol üst konudan üret, sağ üst fikirden üret, sol alt Üretilenler, sağ alt salt okunur detay. Üretim
   sunucuda sürer; concept-work.js /konsept-uretim ve /konseptler uçlarını $.ajax ile kullanır, süren iş varken 2 sn'de bir yoklar.
   Model çıktısı güvenilmeyen veridir: JS yalnızca textContent ile yazar. Metinler resx'ten data-text-* ile gelir. *@
<div class="concept-areas" id="concept-work" data-requires-profile
     data-text-count-invalid="@UiText.WorkCountInvalid" data-text-idea-required="@UiText.WorkIdeaRequired"
     data-text-idea-too-long="@UiText.WorkIdeaTooLong" data-text-topics-running="@UiText.WorkTopicsRunning"
     data-text-running="@UiText.WorkRunning" data-text-done="@UiText.WorkDone" data-text-topics-done="@UiText.WorkTopicsDone"
     data-text-stopped="@UiText.WorkStopped" data-text-failures="@UiText.WorkFailures" data-text-failure-idea="@UiText.WorkFailureIdea"
     data-text-format-rejected="@UiText.WorkFormatRejected" data-text-topic-duplicates="@UiText.WorkTopicDuplicates"
     data-text-idea-duplicates="@UiText.WorkIdeaDuplicates" data-text-dedupe-unavailable="@UiText.WorkDedupeUnavailable"
     data-text-no-new-topics="@UiText.WorkNoNewTopics" data-text-request-failed="@UiText.WorkRequestFailed"
     data-text-loading="@UiText.ConceptsLoading" data-text-load-failed="@UiText.ConceptsLoadFailed"
     data-text-approve="@UiText.ConceptApprove" data-text-unapprove="@UiText.ConceptUnapprove" data-text-select="@UiText.ConceptSelect"
     data-text-approving="@UiText.ConceptApproving" data-text-approve-failed="@UiText.ConceptApproveFailed"
     data-text-warning-words="@UiText.ConceptWarningWords" data-text-warning-duration="@UiText.ConceptWarningDuration"
     data-text-page="@UiText.ConceptsPage" data-text-scene-heading="@UiText.ConceptSceneHeading"
     data-text-scene-visual="@UiText.ConceptSceneVisual" data-text-scene-narration="@UiText.ConceptSceneNarration"
     data-text-scene-duration="@UiText.ConceptSceneDuration" data-text-detail-failed="@UiText.ConceptDetailFailed"
     data-text-status-generated="@UiText.ConceptStatusGenerated" data-text-status-approved="@UiText.ConceptStatusApproved"
     data-text-status-queued="@UiText.ConceptStatusQueued" data-text-status-producing="@UiText.ConceptStatusProducing"
     data-text-status-video_ready="@UiText.ConceptStatusVideoReady">
    <section class="concept-area" id="concept-topic" aria-labelledby="area-topic-title">
        <h2 class="concept-area__title" id="area-topic-title">@UiText.AreaTopic</h2>
        <p class="concept-work__notready" data-not-ready="topics" hidden>
            @UiText.WorkNotReady
            <button type="button" class="link-button" data-open-models>@UiText.WorkOpenModels</button> ·
            <a href="/ayarlar">@UiText.WorkGoSettings</a>
        </p>
        <form class="concept-work__form" id="topic-form" novalidate>
            <label class="field__label" for="topic-count">@UiText.TopicCountLabel</label>
            <input class="field__input field__input--short" id="topic-count" type="number" min="1" max="100" step="1" inputmode="numeric" value="10"
                   aria-describedby="topic-count-error" />
            <button type="submit" class="button button--primary" id="topic-generate" disabled>@UiText.TopicGenerate</button>
            <p class="field__error" id="topic-count-error" role="alert"></p>
        </form>
        <div class="concept-work__job">
            <p class="concept-work__progress" id="topic-progress" role="status" aria-live="polite"></p>
            <button type="button" class="button button--danger" id="topic-stop" hidden>@UiText.WorkStop</button>
        </div>
        <ul class="concept-work__notes" id="topic-notes" aria-live="polite"></ul>
        <p class="concept-area__hint" id="topic-empty">@UiText.AreaTopicHint</p>
        <ul class="suggestion-list" id="topic-list" aria-label="@UiText.TopicListLabel"></ul>
        <p class="field__error" id="topic-produce-error" role="alert"></p>
        <button type="button" class="button button--primary" id="topic-produce" data-not-ready-target="fromTopics" disabled>@UiText.TopicProduce</button>
        <p class="concept-work__notready" data-not-ready="fromTopics" hidden>
            @UiText.WorkNotReady
            <button type="button" class="link-button" data-open-models>@UiText.WorkOpenModels</button> ·
            <a href="/ayarlar">@UiText.WorkGoSettings</a>
        </p>
    </section>
    <section class="concept-area" id="concept-idea" aria-labelledby="area-idea-title">
        <h2 class="concept-area__title" id="area-idea-title">@UiText.AreaIdea</h2>
        <p class="concept-work__notready" data-not-ready="idea" hidden>
            @UiText.WorkNotReady
            <button type="button" class="link-button" data-open-models>@UiText.WorkOpenModels</button> ·
            <a href="/ayarlar">@UiText.WorkGoSettings</a>
        </p>
        <form class="concept-work__form concept-work__form--idea" id="idea-form" novalidate>
            <label class="field__label" for="idea-text">@UiText.IdeaLabel</label>
            <textarea class="field__input concept-work__idea" id="idea-text" rows="4" aria-describedby="idea-text-error"></textarea>
            <p class="field__error" id="idea-text-error" role="alert"></p>
            <label class="field__label" for="idea-count">@UiText.IdeaCountLabel</label>
            <input class="field__input field__input--short" id="idea-count" type="number" min="1" max="100" step="1" inputmode="numeric" value="5"
                   aria-describedby="idea-count-error" />
            <button type="submit" class="button button--primary" id="idea-generate" disabled>@UiText.IdeaGenerate</button>
            <p class="field__error" id="idea-count-error" role="alert"></p>
        </form>
        <div class="concept-work__job">
            <p class="concept-work__progress" id="idea-progress" role="status" aria-live="polite"></p>
            <button type="button" class="button button--danger" id="idea-stop" hidden>@UiText.WorkStop</button>
        </div>
        <ul class="concept-work__notes" id="idea-notes" aria-live="polite"></ul>
        <p class="concept-area__hint" id="idea-hint">@UiText.AreaIdeaHint</p>
    </section>
    <section class="concept-area" id="concept-produced" aria-labelledby="area-produced-title">
        <h2 class="concept-area__title" id="area-produced-title">@UiText.AreaProduced</h2>
        <fieldset class="concept-filter" id="concept-filter">
            <legend class="concept-filter__legend">@UiText.ConceptFilterLegend</legend>
            @foreach (var (code, text, on) in new[]
            {
                ("generated", UiText.ConceptStatusGenerated, true), ("approved", UiText.ConceptStatusApproved, true),
                ("queued", UiText.ConceptStatusQueued, false), ("producing", UiText.ConceptStatusProducing, false),
                ("video_ready", UiText.ConceptStatusVideoReady, false),
            })
            {
                <label class="concept-filter__option"><input type="checkbox" value="@code" checked="@on" /> @text</label>
            }
        </fieldset>
        <p class="empty-state" data-requires-profile id="concepts-empty">@UiText.EmptyConcepts</p>
        <p class="concept-list__status" id="concepts-status" role="status" aria-live="polite"></p>
        <ul class="concept-list" id="concept-list"></ul>
        <div class="concept-list__actions">
            <button type="button" class="button" id="concepts-approve-selected" disabled>@UiText.ConceptsApproveSelected</button>
            <span class="concept-list__pager" id="concepts-pager" hidden>
                <button type="button" class="button" id="concepts-prev">@UiText.ConceptsPrev</button>
                <span id="concepts-page"></span>
                <button type="button" class="button" id="concepts-next">@UiText.ConceptsNext</button>
            </span>
        </div>
    </section>
    <section class="concept-area" id="concept-detail-area" aria-labelledby="area-edit-title">
        <h2 class="concept-area__title" id="area-edit-title">@UiText.AreaEdit</h2>
        <p class="concept-area__hint" id="concept-detail-hint">@UiText.AreaEditHint</p>
        <article class="concept-detail" id="concept-detail" tabindex="-1" hidden></article>
    </section>
</div>

@* Model bilgisi modalı (spec 0005 Req 4–5): sayfanın üstünde ayrı pencere. Kapat düğmesi, dışına tıklama ya da Esc kapatır ve
   seçimleri kaydeder; listede yalnızca seçilebilir metin modelleri (Api'den) vardır. *@
<div class="dialog-backdrop" id="concept-models-modal" hidden>
    <div class="dialog concept-models" role="dialog" aria-modal="true" aria-labelledby="concept-models-title">
        <div class="profile-modal__head">
            <h2 class="profile-modal__title" id="concept-models-title">@UiText.ConceptModelsTitle</h2>
            <button type="button" class="icon-button" id="concept-models-close" aria-label="@UiText.ConceptModelsClose" title="@UiText.ConceptModelsClose">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>
        <div class="concept-models__empty" id="concept-models-empty" hidden>
            <p>@UiText.ConceptModelsNone</p>
            <a class="button" href="/ayarlar">@UiText.ConceptModelsGoSettings</a>
        </div>
        @foreach (var role in roles)
        {
            <div class="field concept-models__role" data-role="@role.Code">
                <label class="field__label" for="concept-model-@role.Code">@role.ModelLabel</label>
                <select class="field__input" id="concept-model-@role.Code" data-model-select>
                    <option value="">@UiText.ConceptNotSelected</option>
                </select>
                <span class="concept-models__effort" data-effort-field hidden>
                    <label class="field__label" for="concept-effort-@role.Code">@role.EffortLabel</label>
                    <select class="field__input" id="concept-effort-@role.Code" data-effort-select></select>
                </span>
            </div>
        }
        <p class="concept-models__status" id="concept-models-status" role="status" aria-live="polite"></p>
    </div>
</div>

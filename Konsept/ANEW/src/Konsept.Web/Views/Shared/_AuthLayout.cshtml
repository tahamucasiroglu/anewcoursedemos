@* Giriş ve kayıt sayfalarının düzeni (spec 0002 Req 19): karşılama bölümü + form; üst bar ve durum şeridi yok (kimliksiz
   sayfa kullanıcı verisi göstermez). Tema düğmesi ve açık/koyu mod ana düzenle aynı. *@
<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @UiText.AppName</title>
    <link rel="icon" type="image/svg+xml" href="~/img/app-icon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="auth-page">
    <div class="auth-page__bar">
        <button type="button" id="theme-toggle" class="icon-button theme-toggle" aria-label="@UiText.ThemeToggle">
            <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5" /></svg>
            <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 15A8 8 0 1 1 9 4a7 7 0 0 0 11 11z" /></svg>
        </button>
    </div>
    <main id="main" class="auth">
        <partial name="_Welcome" />
        <section class="auth__panel">
            @RenderBody()
        </section>
    </main>
    <script type="module" src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>

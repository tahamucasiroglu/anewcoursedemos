@* Kullanıcı menüsü (spec 0002 Req 14): üst barın en sağında, tema düğmesinden sonra; kullanıcının adı ve "Çıkış yap".
   <details>/<summary> klavyeyle açılır (Enter/Space); çıkış CSRF belirteçli POST formudur. *@
<details class="user-menu">
    <summary class="user-menu__toggle" title="@UiText.UserMenuLabel">
        <span class="user-menu__name" title="@User.Identity?.Name">@User.Identity?.Name</span>
    </summary>
    <div class="user-menu__panel">
        <form class="user-menu__logout" method="post" action="/cikis" asp-antiforgery="true">
            <button type="submit" class="user-menu__item">@UiText.Logout</button>
        </form>
    </div>
</details>

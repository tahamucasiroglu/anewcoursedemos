<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ajan altyapısı: SignalR istemcisi (yalnızca ajan tarafında), ayar dosyası, tarayıcı açma. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kurulum bileşen listesi (spec 0009): sabit sürüm, adres, SHA-256; ajana gömülü. -->
    <EmbeddedResource Include="Setup\components.json" LogicalName="Konsept.Agent.Infrastructure.Setup.components.json" />
    <!-- Spec 0018: render ağ koruması (Node ön yükleme modülü) ve HyperFrames npm kilit dosyası (bütünlük: npm integrity). -->
    <EmbeddedResource Include="Sandbox\render-guard.mjs" LogicalName="Konsept.Agent.Infrastructure.Sandbox.render-guard.mjs" />
    <EmbeddedResource Include="Setup\hyperframes\package.json" LogicalName="Konsept.Agent.Infrastructure.Setup.hyperframes.package.json" />
    <EmbeddedResource Include="Setup\hyperframes\package-lock.json" LogicalName="Konsept.Agent.Infrastructure.Setup.hyperframes.package-lock.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Konsept.Agent.Application\Konsept.Agent.Application.csproj" />
    <ProjectReference Include="..\Konsept.Modules.AgentGateway.Contracts\Konsept.Modules.AgentGateway.Contracts.csproj" />
    <ProjectReference Include="..\Konsept.Shared.Logging\Konsept.Shared.Logging.csproj" />
  </ItemGroup>
</Project>

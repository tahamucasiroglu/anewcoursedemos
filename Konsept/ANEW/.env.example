# ANEW Konsept — yerel ortam değişkenleri örneği (docs/security.md). Gerçek değerler REPOYA GİRMEZ.
# deploy/pi/deploy.sh, Pi bağlantısını repo kökündeki (anewcoursedemos/) .env dosyasından okur.

# Pi'ye SSH için ~/.ssh/config içindeki takma ad (ör. "pi").
PI_SSH_ALIAS=
# Pi'nin yerel ağ adresi (ajanın agentsettings.Local.json dosyasında ServerUrl/SiteUrl için).
PI_HOST=

# Pi'deki API veritabanı bağlantısı burada DEĞİL: Pi'de /etc/anewconcept/api.env içinde üretilir (deploy/pi/provision.sh).
# Entegrasyon testleri KONSEPT_TEST_PG'yi scripts/test-db/run-integration.sh ile kendisi ayarlar.

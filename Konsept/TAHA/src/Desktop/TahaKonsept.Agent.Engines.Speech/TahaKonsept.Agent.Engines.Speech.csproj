<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Yerel seslendirme motorları (ISpeechEngine): Supertonic 3 (ONNX Runtime DirectML → CPU yedeği, doğrudan C#) ve
    gömülü Python + uv venv + PythonWorkers/tts_worker.py (JSON-lines) üzerinden çalışan Python motorları.
    Kayıt: services.AddSpeechEngines().
  -->
  <PropertyGroup>
    <RootNamespace>TahaKonsept.Agent.Engines.Speech</RootNamespace>
    <!-- DxgiAdapterQuery: DXGI COM vtable çağrıları (işlev göstericileri) için; başka yerde unsafe kod yok. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TahaKonsept.Agent.Abstractions\TahaKonsept.Agent.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <!--
      DirectML.dll: Microsoft.AI.DirectML kendi hedefleriyle yalnız PlatformTarget=x64 iken (ve hata ayıklama katmanıyla birlikte) kopyalar;
      AnyCPU geliştirme derlemesinde hiç kopyalamaz ve ORT eski sistem DirectML.dll'ine düşer. Bu yüzden paketin build varlıkları kapatılır
      ve yalnız x64 DirectML.dll açıkça çıktıya konur (ProjectReference ile ajanın çıktısına ve yayınına da akar). Ajan yalnız win-x64 yayınlanır.
    -->
    <PackageReference Include="Microsoft.AI.DirectML" GeneratePathProperty="true" ExcludeAssets="build" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PythonWorkers\**\*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="PythonWorkers\assets\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="PythonWorkers\**\__pycache__\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TahaKonsept.Agent.Engines.Speech.Tests" />
  </ItemGroup>

</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TahaKonsept.Agent.ViewModels.Concrete"
        x:Class="TahaKonsept.Agent.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="Taha Konsept — Kurulum"
        Icon="avares://TahaKonsept.Agent/Assets/app.ico"
        Width="900" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <!-- İlk kurulum: 1) ön gereksinimler (ilerleme çubuklu adımlar + günlük) 2) cihaz eşleme (büyük kod) 3) bitti. -->
  <DockPanel>
    <Border Classes="header" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="avares://TahaKonsept.Agent/Assets/app.png" Width="40" Height="40" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="Taha Konsept" />
          <TextBlock Classes="muted" Text="Masaüstü programı kurulumu" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="stepchip" Classes.active="{Binding IsPrerequisitesVisible}">
            <TextBlock Text="1  Bileşenler" FontSize="12" />
          </Border>
          <Border Classes="stepchip" Classes.active="{Binding IsPairingVisible}">
            <TextBlock Text="2  Eşleme" FontSize="12" />
          </Border>
          <Border Classes="stepchip" Classes.active="{Binding IsCompletedVisible}">
            <TextBlock Text="3  Hazır" FontSize="12" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Alt düğme şeridi -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource TkHeader}" BorderBrush="{DynamicResource TkBorder}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="İptal" IsVisible="{Binding IsInstalling}" Command="{Binding CancelInstallCommand}" />
          <Button Content="Geri" IsVisible="{Binding IsPairingVisible}" Command="{Binding BackToPrerequisitesCommand}" />
          <Button Classes="primary" IsVisible="{Binding IsPrerequisitesVisible}" Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
          <Button Classes="primary" IsVisible="{Binding IsCompletedVisible}" Content="Bitir" Command="{Binding FinishCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Margin="20,16">
      <!-- 1) Bileşenler -->
      <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsPrerequisitesVisible}">
        <Grid ColumnDefinitions="*,12,*">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="section" Text="Sunucu adresi" />
              <TextBox Text="{Binding ServerUrl}" Watermark="http://192.168.1.102:7111" IsEnabled="{Binding !IsInstalling}" />
              <TextBlock Classes="danger" FontSize="12" Text="{Binding ServerUrlError}" IsVisible="{Binding ServerUrlError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted" Text="Raspberry Pi üzerindeki Taha Konsept API adresi (port 7111)." />
            </StackPanel>
          </Border>
          <Border Classes="card" Grid.Column="2">
            <StackPanel Spacing="4">
              <TextBlock Classes="section" Text="Ekran kartı" />
              <TextBlock Text="{Binding GpuSummary}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="Yerel ses ve görsel motorları VRAM'e göre önerilir." />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,6">
          <TextBlock Classes="section" Text="Gerekli bileşenler" VerticalAlignment="Center" Margin="0" />
          <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                     Text="{Binding OverallPercent, StringFormat='Genel ilerleme: %{0:0}'}" />
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="0">
          <ScrollViewer>
            <!-- Grid.IsSharedSizeScope: "Kur" onay kutusu olan/olmayan satırlarda ilerleme sütunu aynı hizada kalsın. -->
            <ItemsControl ItemsSource="{Binding Steps}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SetupStepViewModel">
                  <Border BorderBrush="{DynamicResource TkBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepToggle" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Classes="dot" Classes.ok="{Binding IsOk}" Classes.running="{Binding IsRunning}" Classes.failed="{Binding IsFailed}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding Group}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Description}" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" IsVisible="{Binding IsRunning}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" />
                        <TextBlock Classes="muted" Text="{Binding StatusText}" HorizontalAlignment="Right" />
                      </StackPanel>
                      <CheckBox Grid.Column="3" Content="Kur" IsVisible="{Binding IsOptional}" IsEnabled="{Binding CanToggle}"
                                IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Expander Grid.Row="3" Header="Günlük" Margin="0,10,0,0" HorizontalAlignment="Stretch">
          <Border Background="{DynamicResource TkLogBackground}" CornerRadius="8" Padding="10" Height="150">
            <ScrollViewer x:Name="LogScroll">
              <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                               Foreground="{DynamicResource TkLogText}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Expander>
      </Grid>

      <!-- 2) Eşleme -->
      <Border Classes="card" IsVisible="{Binding IsPairingVisible}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Padding="28">
        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
          <TextBlock Classes="title" Text="Bu bilgisayarı hesabınızla eşleyin" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" HorizontalAlignment="Center"
                     Text="Aşağıdaki kodu web arayüzünde (Ayarlar → Masaüstü Programı) onaylayın. 'Tarayıcıda onayla' kodu sizin için doldurur." />
          <Border Background="{DynamicResource TkAccentSoft}" CornerRadius="12" Padding="18" IsVisible="{Binding Pairing.HasCode}">
            <TextBlock Text="{Binding Pairing.UserCode}" FontSize="46" FontWeight="Bold" LetterSpacing="6"
                       Foreground="{DynamicResource TkBrown}" HorizontalAlignment="Center" FontFamily="Cascadia Mono,Consolas,monospace" />
          </Border>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding Pairing.IsBusy}" />
          <TextBlock Text="{Binding Pairing.Message}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Classes="muted" TextAlignment="Center" HorizontalAlignment="Center" Text="{Binding Pairing.VerificationUrl}" IsVisible="{Binding Pairing.HasCode}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="primary" Content="Tarayıcıda onayla" Command="{Binding Pairing.OpenBrowserCommand}" />
            <Button Content="{Binding Pairing.StartButtonText}" Command="{Binding Pairing.StartCommand}" IsVisible="{Binding Pairing.CanRetry}" />
            <Button Content="Vazgeç" Command="{Binding Pairing.CancelCommand}" IsVisible="{Binding Pairing.IsBusy}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 3) Bitti -->
      <Border Classes="card" IsVisible="{Binding IsCompletedVisible}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Padding="28">
        <StackPanel Spacing="12">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource TkSuccess}" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="title" Text="Her şey hazır" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" HorizontalAlignment="Center"
                     Text="Taha Konsept sağ alttaki tepside çalışmaya devam eder. Durum ve motor kurulumu için tepsi ikonuna sağ tıklayın." />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TahaKonsept.Agent.ViewModels.Concrete"
        x:Class="TahaKonsept.Agent.Views.StatusWindow"
        x:DataType="vm:StatusViewModel"
        Title="Taha Konsept — Durum"
        Icon="avares://TahaKonsept.Agent/Assets/app.ico"
        Width="860" Height="680" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <!-- Durum: bağlantı, hesap, bilgisayar, çalışan iş, motorlar (Kur), klasörler, Windows ile başlat. -->
  <DockPanel>
    <Border Classes="header" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="avares://TahaKonsept.Agent/Assets/app.png" Width="40" Height="40" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="Taha Konsept" />
          <TextBlock Classes="muted" Text="{Binding VersionText}" />
        </StackPanel>
        <Border Grid.Column="2" Classes="stepchip" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="dot" Classes.ok="{Binding IsConnected}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding HubStatusText}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource TkHeader}" BorderBrush="{DynamicResource TkBorder}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <CheckBox Content="Windows ile başlat" IsChecked="{Binding StartWithWindows}" />
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Notice}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Log klasörü" Command="{Binding OpenLogsCommand}" />
          <Button Content="Videolar klasörü" Command="{Binding OpenVideosCommand}" />
          <Button Classes="primary" Content="Siteye git" Command="{Binding OpenWebCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Margin="20,16" RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,12,*">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="Hesap" />
            <TextBlock Text="{Binding AccountText}" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Eşle" Command="{Binding PairCommand}" IsVisible="{Binding !IsPaired}" />
              <Button Content="Eşlemeyi kaldır" Command="{Binding UnpairCommand}" IsVisible="{Binding IsPaired}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Column="2">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="Bilgisayar" />
            <TextBlock Text="{Binding GpuSummary}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="Çalışan iş" />
          <TextBlock Text="{Binding JobSummaryText}" TextWrapping="Wrap" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding CurrentJobPercent}" IsVisible="{Binding HasActiveJob}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="card" Margin="0,12,0,0" Padding="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Yerel motorlar" Margin="14,12,14,6" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Engines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EngineItemViewModel">
                  <Border BorderBrush="{DynamicResource TkBorder}" BorderThickness="0,1,0,0" Padding="14,9">
                    <Grid ColumnDefinitions="Auto,*,Auto,180,Auto">
                      <Ellipse Classes="dot" Classes.ok="{Binding IsInstalled}" Classes.running="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding CategoryText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Classes="muted" Text="{Binding VramText}" VerticalAlignment="Center" />
                        <TextBlock Text="Yetersiz VRAM" Foreground="{DynamicResource TkWarning}" FontSize="12" IsVisible="{Binding IsVramInsufficient}" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3" Margin="0,0,12,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsBusy}" />
                        <TextBlock Classes="muted" Text="{Binding StatusText}" HorizontalAlignment="Right" />
                      </StackPanel>
                      <Button Grid.Column="4" Classes="primary" Content="Kur" Command="{Binding InstallCommand}" IsVisible="{Binding !IsInstalled}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>

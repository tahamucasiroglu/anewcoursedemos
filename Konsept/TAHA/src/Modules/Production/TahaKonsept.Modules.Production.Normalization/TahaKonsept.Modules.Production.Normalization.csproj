<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Production modülü: seslendirme metni normalizasyonu (yazılış → okunuş). Saf kütüphane, altyapı bağımlılığı yok.
    Tek G/Ç: gömülü yerleşik okunuş sözlüğü (Resources/builtin-lexicon-tr.json). Kayıt: services.AddSpeechTextNormalization();
    DI'sız kullanım: SpeechTextNormalizerFactory.CreateDefault().
  -->
  <PropertyGroup>
    <RootNamespace>TahaKonsept.Modules.Production.Normalization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\TahaKonsept.Shared.Contracts\TahaKonsept.Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\builtin-lexicon-tr.json" LogicalName="TahaKonsept.Normalization.builtin-lexicon-tr.json" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Taha Konsept Web (MVC, BFF): tarayıcı → MVC (cookie) → API (JWT). Port 7110. -->
  <PropertyGroup>
    <RootNamespace>TahaKonsept.Web</RootNamespace>
    <AssemblyName>TahaKonsept.Web</AssemblyName>
    <UserSecretsId>tahakonsept-web-6c1d2b8e</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\TahaKonsept.Shared.Contracts\TahaKonsept.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\TahaKonsept.BuildingBlocks.Infrastructure\TahaKonsept.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <!-- Marka ikonu tek kaynaktan: source/taha-konsept-app.svg → wwwroot/img/logo.svg (logo + sekme ikonu). -->
  <Target Name="CopyBrandIcons" BeforeTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\source\taha-konsept-app.svg')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\source\taha-konsept-app.svg" DestinationFiles="$(MSBuildThisFileDirectory)wwwroot\img\logo.svg" SkipUnchangedFiles="true" />
  </Target>

</Project>

@{
    ViewData["Title"] = "Silinenler";
}
<div class="tk-page" id="tk-silinenler">
    <div class="tk-page-head">
        <div>
            <h1>Silinenler <small class="tk-muted" id="sl-count"></small></h1>
            <p>Silinen konseptler sonsuza kadar burada saklanır ve benzer konuların tekrar önerilmesini engeller. Buradan silinen tamamen silinir.</p>
        </div>
        <div class="tk-page-actions">
            <input type="search" class="tk-input" id="sl-search" placeholder="Başlık, özet ya da etiket ara…" aria-label="Silinenlerde ara" style="width:260px;max-width:100%" />
            <button type="button" class="tk-mini-btn" id="sl-refresh" title="Yenile" aria-label="Yenile">
                <svg class="tk-ic" aria-hidden="true"><use href="/img/icons.svg#i-refresh"></use></svg>
            </button>
        </div>
    </div>

    <section class="tk-card">
        <div class="tk-card-body is-flush" id="sl-list"></div>
    </section>
</div>

@section Scripts {
    <script src="~/js/pages/silinenler.js" asp-append-version="true"></script>
}

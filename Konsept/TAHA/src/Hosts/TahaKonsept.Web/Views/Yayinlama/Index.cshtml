@{
    ViewData["Title"] = "Yayınlama";
}
<div class="tk-soon">
    <div class="tk-soon-card">
        <div class="tk-soon-icon">
            <svg class="tk-ic" aria-hidden="true"><use href="/img/icons.svg#i-send"></use></svg>
        </div>
        <h1>Çok yakında sizlerleyiz</h1>
        <p>Ürettiğiniz videoları kanallarınızda zamanlayıp tek yerden yayınlayabileceğiniz bölüm üzerinde çalışıyoruz.</p>
        <div class="tk-soon-chips">
            <span class="tk-badge is-accent"><svg class="tk-ic tk-ic-sm" aria-hidden="true"><use href="/img/icons.svg#i-calendar"></use></svg> Yayın takvimi</span>
            <span class="tk-badge is-accent"><svg class="tk-ic tk-ic-sm" aria-hidden="true"><use href="/img/icons.svg#i-channel"></use></svg> Çoklu kanal</span>
            <span class="tk-badge is-accent"><svg class="tk-ic tk-ic-sm" aria-hidden="true"><use href="/img/icons.svg#i-chart"></use></svg> Performans</span>
        </div>
    </div>
</div>

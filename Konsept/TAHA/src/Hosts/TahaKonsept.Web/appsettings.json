{
  "Api": {
    "BaseUrl": "http://127.0.0.1:7111",
    "TimeoutSeconds": 120,
    "RefreshSkewSeconds": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:7110" }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Directory": "logs",
    "RetainedDays": 7
  },
  "AllowedHosts": "*"
}

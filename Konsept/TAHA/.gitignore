# Kök .gitignore 'Source/' kuralını bu proje için geri al (14 Kas 2026 kararı): ikon/tasarım görselleri depoya girer
!source/
# Büyük ikili dosyalar depoya girmez
source/**/*.mp4
source/**/*.mov
source/**/*.mkv
source/**/*.wav
source/**/*.gguf
source/**/*.onnx
source/**/*.safetensors
# Calisma zamani gizli anahtarlari ve gecici veriler (asla depoya girmez)
**/App_Data/keys/
**/App_Data/artifacts/
**/logs/
# Gelistirici arac klasoru (portable ffmpeg vb., asla depoya girmez)
.tools-dev/
